<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ServerMultipass</AssemblyName>
    <RootNamespace>ServerMultipass</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <ModFolderName>1_ServerMultipass</ModFolderName>
  </PropertyGroup>

  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">/home/sdtdtest/serverfiles</GameRoot>
    <ManagedDir Condition="Exists('$(GameRoot)/7DaysToDieServer_Data/Managed')">$(GameRoot)/7DaysToDieServer_Data/Managed</ManagedDir>
    <PackageDir Condition="'$(PackageDir)' == ''">$(MSBuildProjectDirectory)/bin/$(ModFolderName)</PackageDir>
    <ModsDir Condition="'$(ModsDir)' == ''">$(GameRoot)/Mods</ModsDir>
  </PropertyGroup>

  <Target Name="CheckManagedDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ManagedDir)' == ''" Text="Managed directory not found under $(GameRoot)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ModDocument Include="ModInfo.xml;README.md;README.ru.md" />
    <ModConfig Include="ServerMultipass.xml" />
    <ModConfig Include="Settings/*.xml" Folder="Settings/" />
    <ModConfig Include="Lang/*.csv" Folder="Lang/" />
    <ModXml Include="Xml/**/*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(ManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRoot)/Mods/0_TFP_Harmony/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build">
    <ItemGroup>
      <ModBinary Include="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ModBinary);@(ModDocument)" DestinationFolder="$(PackageDir)" />
    <Copy SourceFiles="@(ModConfig)" DestinationFiles="@(ModConfig->'$(PackageDir)/%(Folder)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(PackageDir)/Xml" />
    <Copy SourceFiles="@(ModXml)" DestinationFiles="@(ModXml->'$(PackageDir)/Xml/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Mod folder: $(PackageDir)" />
  </Target>

  <Target Name="DeployToMods" AfterTargets="PackageMod" Condition="'$(Deploy)' == 'true'">
    <PropertyGroup>
      <ModDir>$(ModsDir)/$(ModFolderName)</ModDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFile Include="@(ModBinary);@(ModDocument)" />
      <DeployConfig Include="@(ModConfig)">
        <Destination>$(ModDir)/%(ModConfig.Folder)%(ModConfig.Filename)%(ModConfig.Extension)</Destination>
      </DeployConfig>
      <NewConfig Include="@(DeployConfig)" Condition="!Exists('%(Destination)')" />
    </ItemGroup>
    <Delete Files="@(DeployFile->'$(ModDir)/%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DeployFile)" DestinationFolder="$(ModDir)" />
    <Copy SourceFiles="@(NewConfig)" DestinationFiles="@(NewConfig->'%(Destination)')" />
    <RemoveDir Directories="$(ModDir)/Xml" />
    <Copy SourceFiles="@(ModXml)" DestinationFiles="@(ModXml->'$(ModDir)/Xml/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Deployed to $(ModDir), Xml was replaced, existing Settings, Lang and ServerMultipass.xml were kept" />
  </Target>

</Project>

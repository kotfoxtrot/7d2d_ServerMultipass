<ChatDecor>
  <!-- Put the tag and the coloured name in front of the message like classic chat plugins. Then players who blocked this person still see the messages, and nameColor works only in this mode -->
  <property name="TagBeforeName" value="false" />
  <!-- One line per player. id is the EOS or Steam id (the lp console command shows it), tag is any text with colour codes, colours are RRGGBB -->
